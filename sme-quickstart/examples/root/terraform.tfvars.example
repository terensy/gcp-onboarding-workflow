# 複製為 terraform.tfvars 後填入貴組織的實際值，terraform.tfvars 不應提交到版控。

org_id             = "123456789012"
domain             = "example.com"
billing_account_id = "012345-6789AB-CDEF01"

labels = {
  team = "platform"
}

# ---------------------------------------------------------------------------
# 2.1 Folder / Project
# ---------------------------------------------------------------------------
host_project_id = "prj-host-shared-vpc"

service_project_ids = [
  "prj-app-frontend",
  "prj-app-backend",
]

logging_project_id = "prj-logging"

# ---------------------------------------------------------------------------
# 2.2 Organization Policies —— enabled_policy_ids 已有 SME 預設子集（見
# variables.tf），一般不需要調整；這裡只要填兩個 list 型政策實際要用的值。
# ---------------------------------------------------------------------------
allowed_customer_ids       = ["C0xxxxxxx"]
allowed_resource_locations = ["in:asia-east1-locations"]

# ---------------------------------------------------------------------------
# 3. 網路設計
# ---------------------------------------------------------------------------
subnets = {
  subnet-app-asia-east1 = {
    region        = "asia-east1"
    ip_cidr_range = "10.0.0.0/22"
    secondary_ranges = {
      gke-pods     = "10.4.0.0/14"
      gke-services = "10.8.0.0/20"
    }
  }
  subnet-data-asia-east1 = {
    region        = "asia-east1"
    ip_cidr_range = "10.0.4.0/22"
  }
}

# ---------------------------------------------------------------------------
# Cloud VPN（HA VPN）——沒有混合雲需求時整段留著註解即可，enable_vpn 預設 false。
# 要接地端網路時取消註解、填入實際值：shared_secret 建議另外用
# TF_VAR_vpn_tunnel_shared_secrets 環境變數帶入，不要明文寫進這個檔案。
# ---------------------------------------------------------------------------
# enable_vpn        = true
# vpn_region        = "asia-east1"
# vpn_gateway_name  = "ha-vpn-gw-asia-east1"
#
# vpn_peer_gateway_name = "onprem-dc1-gw"
# vpn_peer_asn          = 65001
# vpn_peer_external_ips = [
#   "203.0.113.10", # 地端設備 1 對外 IP
#   "203.0.113.20", # 地端設備 2 對外 IP，兩個才會是 TWO_IPS_REDUNDANT
# ]
#
# vpn_tunnels = {
#   tunnel-0 = {
#     vpn_gateway_interface     = 0
#     peer_gateway_interface    = 0
#     cloud_router_bgp_ip_range = "169.254.0.1/30"
#     peer_bgp_ip_address       = "169.254.0.2"
#   }
#   tunnel-1 = {
#     vpn_gateway_interface     = 1
#     peer_gateway_interface    = 1
#     cloud_router_bgp_ip_range = "169.254.1.1/30"
#     peer_bgp_ip_address       = "169.254.1.2"
#   }
# }
#
# 共用金鑰不要寫在這裡，改用環境變數帶入，例如：
#   export TF_VAR_vpn_tunnel_shared_secrets='{"tunnel-0":"CHANGE_ME_0","tunnel-1":"CHANGE_ME_1"}'
